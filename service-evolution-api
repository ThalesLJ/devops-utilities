create_backup() {
    local backup_dir="${INSTALL_DIR}/backups"
    mkdir -p "$backup_dir"
    if id "evolution-user" >/dev/null 2>&1; then
        run_elevated chown -R evolution-user:evolution-user "$backup_dir" 2>/dev/null || true
    fi

    local b_ts
    b_ts="$(date +%Y%m%d-%H%M%S)"
    local b_file="${backup_dir}/evolution-api-backup-${b_ts}.tar.gz"
    local db_dump="${backup_dir}/evolution-db-${b_ts}.sql"
    local db_cold_tar="${backup_dir}/evolution-db-cold-${b_ts}.tar.gz"

    # Extract database credentials from .env
    local db_user db_name db_pass
    db_user="$(grep -E '^POSTGRES_USER=' "${INSTALL_DIR}/.env" 2>/dev/null | cut -d'=' -f2- | tr -d ' ' || echo "evolution")"
    db_name="$(grep -E '^POSTGRES_DB=' "${INSTALL_DIR}/.env" 2>/dev/null | cut -d'=' -f2- | tr -d ' ' || echo "evolution")"
    db_pass="$(grep -E '^POSTGRES_PASSWORD=' "${INSTALL_DIR}/.env" 2>/dev/null | cut -d'=' -f2- | tr -d ' ' || echo "")"

    info "Exporting PostgreSQL database..."
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^evolution_postgres$"; then
        if docker exec -e PGPASSWORD="$db_pass" evolution_postgres pg_dump -U "$db_user" "$db_name" > "$db_dump" 2>/dev/null; then
            ok "Live database dumped to $db_dump"
        else
            warn "Failed to execute live pg_dump inside evolution_postgres container."
            rm -f "$db_dump"
        fi
    else
        warn "evolution_postgres container is not running; falling back to cold database backup."
    fi

    # Fallback to cold volume backup if live pg_dump was not produced
    if [ ! -f "$db_dump" ]; then
        info "Performing cold backup of evolution_postgres_data volume..."
        if docker volume inspect evolution_postgres_data >/dev/null 2>&1; then
            docker run --rm \
                -v evolution_postgres_data:/var/lib/postgresql/data:ro \
                -v "$backup_dir":/backup \
                alpine tar -czf "/backup/evolution-db-cold-${b_ts}.tar.gz" -C /var/lib/postgresql/data . 2>/dev/null || true
            [ -f "$db_cold_tar" ] && ok "Cold database volume archived to $db_cold_tar"
        else
            warn "evolution_postgres_data volume not found; skipping cold volume backup."
        fi
    fi

    # Backup instances volume using a temporary alpine container
    local instances_tar="${backup_dir}/instances-${b_ts}.tar.gz"
    info "Archiving WhatsApp instances volume..."
    if docker volume inspect evolution_instances >/dev/null 2>&1; then
        docker run --rm \
            -v evolution_instances:/instances:ro \
            -v "$backup_dir":/backup \
            alpine tar -czf "/backup/instances-${b_ts}.tar.gz" -C /instances . 2>/dev/null || true
        [ -f "$instances_tar" ] && ok "Instances archived to $instances_tar"
    fi

    # Backup store volume if present
    local store_tar="${backup_dir}/store-${b_ts}.tar.gz"
    if docker volume inspect evolution_store >/dev/null 2>&1; then
        docker run --rm \
            -v evolution_store:/store:ro \
            -v "$backup_dir":/backup \
            alpine tar -czf "/backup/store-${b_ts}.tar.gz" -C /store . 2>/dev/null || true
        [ -f "$store_tar" ] && ok "Media store archived to $store_tar"
    fi

    info "Creating compressed final archive ($b_file)..."
    local config_files=(".env" "docker-compose.yml")
    [ -f "${INSTALL_DIR}/redis.conf" ] && config_files+=("redis.conf")

    tar -czf "$b_file" \
        -C "$INSTALL_DIR" "${config_files[@]}" \
        -C "$backup_dir" $([ -f "$db_dump" ] && basename "$db_dump") $([ -f "$db_cold_tar" ] && basename "$db_cold_tar") $([ -f "$instances_tar" ] && basename "$instances_tar") $([ -f "$store_tar" ] && basename "$store_tar") 2>/dev/null || true

    rm -f "$db_dump" "$db_cold_tar" "$instances_tar" "$store_tar"

    if [ -f "$b_file" ]; then
        chmod 600 "$b_file" 2>/dev/null || true
        if id "evolution-user" >/dev/null 2>&1; then
            run_elevated chown evolution-user:evolution-user "$b_file" 2>/dev/null || true
        fi
        LATEST_BACKUP_FILE="$b_file"
        ok "Backup created successfully: $b_file"
        info "Archive contains: configuration files (.env, docker-compose.yml), database snapshot, and WhatsApp session instances."

        # Enforce retention policy: strictly maintain maximum 10 backup archives
        local all_backups
        # shellcheck disable=SC2012
        all_backups="$(ls -1t "${backup_dir}"/evolution-api-backup-*.tar.gz 2>/dev/null || true)"
        local total_backups
        total_backups="$(echo "$all_backups" | grep -c 'evolution-api-backup-' || echo 0)"
        if [ "$total_backups" -gt 10 ]; then
            info "Enforcing retention limit: keeping 10 most recent backups (found $total_backups)..."
            echo "$all_backups" | tail -n +"$(( 10 + 1 ))" | while IFS= read -r old_file; do
                if [ -n "$old_file" ] && [ -f "$old_file" ]; then
                    rm -f "$old_file"
                    info "Pruned old backup: $(basename "$old_file")"
                fi
            done
        fi

        return 0
    else
        err "Backup creation failed."
        return 1
    fi
}

action_backup() {
    print_banner
    print_section "Evolution API Backup"

