create_rollback_manifest() {
    local prev_image="$1"
    local prev_env_bak="$2"
    local prev_compose_bak="$3"
    local backup_tar="$4"
    local snap_file="$5"
    local manifest_file="${INSTALL_DIR}/backups/rollback-manifest-${START_TS}.env"

    cat <<EOF > "$manifest_file"
# Evolution API Rollback Manifest
# Created: $(date '+%Y-%m-%d %H:%M:%S')
INSTALL_DIR="${INSTALL_DIR}"
PREV_IMAGE="${prev_image}"
PREV_ENV_BACKUP="${prev_env_bak}"
PREV_COMPOSE_BACKUP="${prev_compose_bak}"
BACKUP_ARCHIVE="${backup_tar}"
SNAPSHOT_FILE="${snap_file}"
PORT="${EVOLUTION_PORT}"
EOF

    chmod 600 "$manifest_file" 2>/dev/null || true
    cp "$manifest_file" "$LATEST_MANIFEST" 2>/dev/null || true
    ok "Rollback manifest saved: $manifest_file"
}

perform_rollback() {
    print_banner
    print_section "Evolution API Rollback"

    local manifest=""
    if [ -f "$LATEST_MANIFEST" ]; then
        manifest="$LATEST_MANIFEST"
    elif [ -d "${INSTALL_DIR}/backups" ]; then
        manifest="$(ls -t "${INSTALL_DIR}/backups"/rollback-manifest-*.env 2>/dev/null | head -n1 || true)"
    fi

    if [ -z "$manifest" ] || [ ! -f "$manifest" ]; then
        err "No rollback manifest found. Cannot perform automated rollback."
        info "You can manually restore your config and database from ${INSTALL_DIR}/backups/"
        exit 1
    fi

    info "Loading rollback manifest: $manifest"
    # shellcheck disable=SC1090
    . "$manifest"

    info "Previous Configuration:"
    printf '    %s %s\n' "Install Dir   :" "$INSTALL_DIR"
    printf '    %s %s\n' "Previous Image:" "${PREV_IMAGE:-unknown}"
    printf '    %s %s\n' "Backup Archive:" "${BACKUP_ARCHIVE:-none}"

    if [ "$ASSUME_YES" -eq 0 ]; then
        if ! ask "Restore Evolution API to this previous configuration state?"; then
            warn "Rollback cancelled by user."
            exit 0
        fi
    fi

    cd "$INSTALL_DIR" || exit 1
    detect_compose || { err "Docker Compose is required."; exit 1; }

    # Restore .env and docker-compose.yml
    if [ -n "${PREV_ENV_BACKUP:-}" ] && [ -f "$PREV_ENV_BACKUP" ]; then
        info "Restoring .env from $PREV_ENV_BACKUP..."
        cp "$PREV_ENV_BACKUP" "${INSTALL_DIR}/.env"
        chmod 600 "${INSTALL_DIR}/.env"
    fi
    if [ -n "${PREV_COMPOSE_BACKUP:-}" ] && [ -f "$PREV_COMPOSE_BACKUP" ]; then
        info "Restoring docker-compose.yml from $PREV_COMPOSE_BACKUP..."
        cp "$PREV_COMPOSE_BACKUP" "${INSTALL_DIR}/docker-compose.yml"
        chmod 644 "${INSTALL_DIR}/docker-compose.yml"
    fi

    # Redeploy previous container image
    info "Redeploying stack with previous configuration..."
    $COMPOSE_CMD up -d --remove-orphans

    # Optional restore of database if needed
    if [ -n "${BACKUP_ARCHIVE:-}" ] && [ -f "$BACKUP_ARCHIVE" ]; then
        if ask "Do you also want to restore the PostgreSQL database from the backup archive?"; then
            info "Extracting database dump from archive..."
            local tmp_restore
            tmp_restore="$(mktemp -d)"
            tar -xzf "$BACKUP_ARCHIVE" -C "$tmp_restore" 2>/dev/null || true
            local dump_sql
            dump_sql="$(ls "$tmp_restore"/evolution-db-*.sql 2>/dev/null | head -n1 || true)"
            if [ -n "$dump_sql" ] && [ -f "$dump_sql" ]; then
                local db_user db_name db_pass
                db_user="$(grep -E '^POSTGRES_USER=' "${INSTALL_DIR}/.env" | cut -d'=' -f2- | tr -d ' ' || echo "evolution")"
                db_name="$(grep -E '^POSTGRES_DB=' "${INSTALL_DIR}/.env" | cut -d'=' -f2- | tr -d ' ' || echo "evolution")"
                db_pass="$(grep -E '^POSTGRES_PASSWORD=' "${INSTALL_DIR}/.env" | cut -d'=' -f2- | tr -d ' ' || echo "")"
                info "Restoring PostgreSQL database..."
                docker exec -i -e PGPASSWORD="$db_pass" evolution_postgres psql -U "$db_user" "$db_name" < "$dump_sql" 2>/dev/null || warn "Database restore encountered warnings."
                ok "Database restore applied."
            fi
            rm -rf "$tmp_restore"
        fi
    fi

    # Verify health
    info "Verifying health after rollback..."
    local cur_port
    cur_port="$(grep -E '^SERVER_PORT=' "${INSTALL_DIR}/.env" 2>/dev/null | cut -d'=' -f2 | tr -d ' ' || echo "${PORT:-8080}")"
    sleep 5
    if curl -sf --max-time 3 "http://localhost:${cur_port}/" >/dev/null 2>&1; then
        ok "Evolution API is responding normally after rollback!"
    else
        warn "Evolution API container restarted, but HTTP response not yet 200. Check logs with: $0 --logs"
    fi

    ok "Rollback execution completed."
    exit 0
}

