action_update() {
    acquire_lock
    print_banner
    print_section "Evolution API Safe Update"

    # 1. Verify existing installation
    if [ ! -d "$INSTALL_DIR" ] || [ ! -f "${INSTALL_DIR}/docker-compose.yml" ] || [ ! -f "${INSTALL_DIR}/.env" ]; then
        err "Evolution API is not installed at ${INSTALL_DIR}."
        err "Cannot update a non-existent installation."
        info "To perform a new installation, run: $0 (or $0 -y)"
        exit 1
    fi

    # 2. Prerequisites & checks
    check_platform || exit 1
    check_system_resources
    ensure_docker_environment || exit 1

    cd "$INSTALL_DIR" || exit 1

    # 3. Read and preserve current environment
    local cur_image cur_port cur_url
    cur_image="$(grep -E '^EVOLUTION_IMAGE=' "${INSTALL_DIR}/.env" 2>/dev/null | cut -d'=' -f2- | tr -d ' ' || echo "$DEFAULT_IMAGE")"
    [ -z "$cur_image" ] && cur_image="$DEFAULT_IMAGE"
    cur_port="$(grep -E '^SERVER_PORT=' "${INSTALL_DIR}/.env" 2>/dev/null | cut -d'=' -f2- | tr -d ' ' || echo "$DEFAULT_PORT")"
    cur_url="$(grep -E '^SERVER_URL=' "${INSTALL_DIR}/.env" 2>/dev/null | cut -d'=' -f2- | tr -d ' ' || echo "unknown")"
    EVOLUTION_PORT="$cur_port"

    # Target image
    local target_image="$cur_image"
    if [ -n "$EVOLUTION_IMAGE" ] && [ "$EVOLUTION_IMAGE" != "$DEFAULT_IMAGE" ]; then
        target_image="$EVOLUTION_IMAGE"
    fi

    info "Current Installation Details:"
    printf '    %s %s\n' "Install Directory :" "$INSTALL_DIR"
    printf '    %s %s\n' "Current Image     :" "$cur_image"
    printf '    %s %s\n' "Target Image      :" "$target_image"
    printf '    %s %s\n' "Configured Port   :" "$cur_port"
    printf '    %s %s\n' "Configured URL    :" "$cur_url"

    # Interactive confirmation
    if [ "$ASSUME_YES" -eq 0 ]; then
        printf '\n'
        if [ "$target_image" = "$cur_image" ]; then
            info "Update will pull the latest layer for '${target_image}' and restart containers."
        else
            info "Update will switch image to '${target_image}', pull and restart containers."
        fi
        if ! ask "Proceed with safe update of Evolution API?"; then
            warn "Update cancelled by user."
            exit 0
        fi
    fi

    # 4. Generate pre-update state snapshot (.txt)
    local snap_file="${LOG_DIR}/evolution-api-pre-update-${START_TS}.txt"
    generate_pre_update_snapshot

    # 5. Backup database, instances, and config files
    info "Performing safety backup before updating..."
    if ! create_backup; then
        err "Safety backup failed. Aborting update to prevent potential data loss."
        exit 1
    fi

    # Backup current .env and docker-compose.yml files specifically
    local env_bak="${INSTALL_DIR}/backups/.env.pre-update-${START_TS}"
    local compose_bak="${INSTALL_DIR}/backups/docker-compose.yml.pre-update-${START_TS}"
    cp "${INSTALL_DIR}/.env" "$env_bak"
    cp "${INSTALL_DIR}/docker-compose.yml" "$compose_bak"

    # 6. Save rollback manifest
    create_rollback_manifest "$cur_image" "$env_bak" "$compose_bak" "$LATEST_BACKUP_FILE" "$snap_file"

    # 7. Update .env and compose if target image is different
    if [ "$target_image" != "$cur_image" ]; then
        info "Updating image reference in .env to ${target_image}..."
        if grep -q '^EVOLUTION_IMAGE=' "${INSTALL_DIR}/.env"; then
            sed -i.bak "s|^EVOLUTION_IMAGE=.*|EVOLUTION_IMAGE=${target_image}|" "${INSTALL_DIR}/.env"
            rm -f "${INSTALL_DIR}/.env.bak"
        else
            printf 'EVOLUTION_IMAGE=%s\n' "$target_image" >> "${INSTALL_DIR}/.env"
        fi
    fi

    # 8. Pull new image
    print_section "Pulling Updated Images"
    info "Pulling Docker image: ${target_image}..."
    if [ "$TTY" = 1 ]; then
        docker pull "$target_image" &
        local pull_pid=$!
        _spin "$pull_pid" "Pulling updated Evolution API image..."
        if ! wait "$pull_pid"; then
            err "Failed to pull Docker image: ${target_image}"
            warn "Aborting update. Existing containers were not modified."
            exit 1
        fi
    else
        if ! docker pull "$target_image"; then
            err "Failed to pull Docker image: ${target_image}"
            warn "Aborting update. Existing containers were not modified."
            exit 1
        fi
    fi
    ok "Docker image ${target_image} downloaded successfully."

    # 9. Apply updates with docker compose up -d
    print_section "Recreating Evolution API Stack"
    info "Applying container update with Docker Compose..."
    if ! $COMPOSE_CMD up -d --remove-orphans; then
        err "Docker Compose failed to apply the update."
        warn "Safety rollback is available to restore the previous state."
        if ask "Execute automatic ROLLBACK now?"; then
            perform_rollback
        fi
        exit 1
    fi
    ok "Containers recreated and updated."

    # 10. Health check verification
    info "Waiting for Evolution API to become healthy..."
    local attempts=0
    local max_attempts=40
    local healthy=0

    while [ $attempts -lt $max_attempts ]; do
        attempts=$(( attempts + 1 ))
        if [ "$TTY" = 1 ]; then
            printf '\r  \033[1;36m⠋\033[0m Verifying Evolution API health check (attempt %d/%d)...' "$attempts" "$max_attempts" > /dev/tty 2>/dev/null || true
        fi

        if curl -sf --max-time 3 "http://localhost:${cur_port}/" >/dev/null 2>&1; then
            healthy=1
            break
        fi
        sleep 3
    done
    [ "$TTY" = 1 ] && printf '\r\033[K' > /dev/tty 2>/dev/null || true

    if [ "$healthy" -ne 1 ]; then
        err "Evolution API health check failed after update!"
        warn "The container may have crashed or failed database migrations."
        printf '\n'
        info "Recent container logs:"
        $COMPOSE_CMD logs --tail=40 evolution-api 2>&1 || true
        printf '\n'
        warn "Safety rollback is available to restore your previous configuration and database."
        if ask "Execute automatic ROLLBACK now?"; then
            perform_rollback
        fi
        exit 1
    fi

    ok "Evolution API is responding with HTTP 200 OK on port ${cur_port}!"

    # 11. Summary
    print_section "Update Complete"
    ok "Evolution API has been safely updated and verified!"
    printf '\n'
    printf '    %s %s -> %s\n' "Container Image:" "$cur_image" "${C_GREEN}${target_image}${C_RESET}"
    printf '    %s %s\n'      "API URL        :" "${C_CYAN}${cur_url}${C_RESET}"
    printf '    %s %s\n'      "Pre-Update Snap:" "${C_CYAN}${snap_file}${C_RESET}"
    printf '    %s %s\n'      "Safety Backup  :" "${C_CYAN}${LATEST_BACKUP_FILE}${C_RESET}"
    printf '    %s %s\n'      "Rollback File  :" "${C_CYAN}${LATEST_MANIFEST}${C_RESET}"
    printf '    %s %s\n'      "Execution Log  :" "${LOG_FILE}"
    printf '\n'
    info "If any issues arise with this new version, you can roll back at any time with:"
    printf '    %s\n' "${C_BOLD}sudo bash $0 --rollback${C_RESET}"
    printf '\n'
    log "Evolution API update completed. Maintainer: Inova e-Business"
    printf '\n'
    exit 0
}

action_uninstall() {
    print_banner
    print_section "Evolution API Uninstallation"

    if [ ! -d "$INSTALL_DIR" ]; then
        err "Installation directory $INSTALL_DIR does not exist."
        exit 1
    fi

    warn "This will stop and remove the Evolution API stack."
    if ! ask "Are you sure you want to proceed with uninstallation?"; then
        info "Uninstallation cancelled."
        exit 0
    fi

    detect_compose || true
    if [ -n "$COMPOSE_CMD" ] && [ -f "${INSTALL_DIR}/docker-compose.yml" ]; then
        info "Stopping and removing containers..."
        cd "$INSTALL_DIR" && $COMPOSE_CMD down 2>/dev/null || true
    fi

    if command -v systemctl >/dev/null 2>&1 && [ -f "/etc/systemd/system/evolution-api.service" ]; then
        info "Disabling systemd service..."
        run_elevated systemctl stop evolution-api.service 2>/dev/null || true
        run_elevated systemctl disable evolution-api.service 2>/dev/null || true
        run_elevated rm -f "/etc/systemd/system/evolution-api.service"
        run_elevated systemctl daemon-reload 2>/dev/null || true
        ok "Removed systemd service."
    fi

    printf '\n'
    if ask "Do you want to permanently delete all persistent data volumes (database, instances, messages)?"; then
        if command -v docker >/dev/null 2>&1; then
            docker volume rm evolution_instances evolution_store evolution_postgres_data evolution_redis_data 2>/dev/null || true
            ok "Docker persistent volumes removed."
        fi
        run_elevated rm -rf "$INSTALL_DIR"
        ok "Removed directory: $INSTALL_DIR"
    else
        ok "Persistent Docker volumes preserved. Only configuration files removed."
        run_elevated rm -f "${INSTALL_DIR}/docker-compose.yml"
    fi

    ok "Evolution API uninstalled successfully."
    exit 0
}

# -----------------------------------------------------------------------------
# Main Installation Flow
# -----------------------------------------------------------------------------
main_install() {
    acquire_lock
    print_banner

    # 1. Platform & OS Checks
    print_section "System Prerequisites"
    check_platform || exit 1
    check_system_resources

    # 2. Interactive Prompts (if not -y)
    if [ "$ASSUME_YES" -eq 0 ] && [ "$CHECK_ONLY" -eq 0 ]; then
        print_section "Installation Configuration"
        prompt_value "Installation directory" "$DEFAULT_INSTALL_DIR" INSTALL_DIR
        prompt_value "HTTP port for Evolution API" "$DEFAULT_PORT" EVOLUTION_PORT
        
        local auto_url
        auto_url="$(detect_server_url "$EVOLUTION_PORT")"
        prompt_value "Server URL (used for webhooks and instances)" "$auto_url" SERVER_URL

        local gen_key
        gen_key="$(generate_secret 64)"
        prompt_value "Global Authentication API Key" "$gen_key" AUTHENTICATION_API_KEY
    fi

    # Normalize directory path (convert Windows backslashes to Linux forward slashes, trim trailing slash)
    INSTALL_DIR="${INSTALL_DIR//\\//}"
    INSTALL_DIR="${INSTALL_DIR%/}"
    [ -n "$INSTALL_DIR" ] || INSTALL_DIR="$DEFAULT_INSTALL_DIR"

    # 3. Port conflict check
    if ! check_port_available "$EVOLUTION_PORT"; then
        warn "Port ${EVOLUTION_PORT} appears to be in use by another process."
        if [ "$CHECK_ONLY" -eq 0 ] && ! ask "Continue anyway with port ${EVOLUTION_PORT}?"; then
            err "Installation aborted due to port conflict."
            exit 1
        fi
    else
        ok "Port ${EVOLUTION_PORT} is available."
    fi

    # 4. Docker Environment
    ensure_docker_environment || {
        if [ "$CHECK_ONLY" -eq 1 ]; then
            printf '\n'
            warn "System check completed: Docker is missing and will be installed during setup."
            info "To proceed with full installation, run: $0"
            exit 0
        fi
        exit 1
    }

    # If check-only mode, stop here
    if [ "$CHECK_ONLY" -eq 1 ]; then
        printf '\n'
        ok "Pre-flight checks completed. System is ready for Evolution API."
        info "To execute the full installation, run: $0"
        exit 0
    fi

    # Confirmation before making changes
    if [ "$ASSUME_YES" -eq 0 ]; then
        printf '\n'
        info "Summary of installation:"
        printf '    %s: %s\n' "Directory" "$INSTALL_DIR"
        printf '    %s: %s\n' "Port" "$EVOLUTION_PORT"
        printf '    %s: %s\n' "Server URL" "${SERVER_URL:-$(detect_server_url "$EVOLUTION_PORT")}"
        printf '    %s: %s\n' "Image" "$EVOLUTION_IMAGE"
        printf '\n'
        if ! ask "Proceed with installation and container startup?"; then
            warn "Installation cancelled by user."
            exit 0
        fi
    fi

    # 5. Generate configuration
    generate_configuration_files

    # 6. Setup systemd unit
    setup_systemd_service

    # 7. Deploy containers & check health
    deploy_stack

    # 8. Post-install Summary
    print_section "Installation Complete"
    ok "Evolution API has been successfully installed and launched!"
    printf '\n'
    printf '  %s\n' "${C_BOLD}Access & Authentication Details:${C_RESET}"
    printf '    %s %s\n' "API URL    :" "${C_CYAN}${SERVER_URL}${C_RESET}"
    printf '    %s %s\n' "Healthcheck:" "${C_CYAN}${SERVER_URL}/${C_RESET}"
    printf '    %s %s\n' "API Docs   :" "${C_CYAN}${SERVER_URL}/docs${C_RESET}"
    printf '    %s %s\n' "API Key    :" "${C_YELLOW}${AUTHENTICATION_API_KEY}${C_RESET}"
    printf '\n'
    printf '  %s\n' "${C_BOLD}Architecture & Storage:${C_RESET}"
    printf '    %s %s\n' "Config Dir :" "${INSTALL_DIR}"
    printf '    %s %s\n' "PostgreSQL :" "evolution_postgres (internal Docker network)"
    printf '    %s %s\n' "Redis Cache:" "evolution_redis (internal Docker network, AOF enabled)"
    printf '    %s %s\n' "Persistence:" "Docker named volumes (evolution_instances, evolution_postgres_data)"
    printf '\n'
    printf '  %s\n' "${C_BOLD}Management Commands:${C_RESET}"
    printf '    %s\n' "Check API Key: $0 --apiKey"
    printf '    %s\n' "View logs:     $0 --logs"
    printf '    %s\n' "Restart stack: $0 --restart"
    printf '    %s\n' "Stop stack:    $0 --stop"
    printf '    %s\n' "Start stack:   $0 --start"
    printf '    %s\n' "Create backup: $0 --backup"
    printf '    %s\n' "Update stack:  $0 --update"
    printf '    %s\n' "Rollback:      $0 --rollback"
    if [ "$INSTALL_SYSTEMD" -eq 1 ]; then
        printf '    %s\n' "Systemd:       sudo systemctl status evolution-api"
    fi
    printf '\n'
    log "Evolution API service completed. Maintainer: Inova e-Business"
    printf '\n'
}

# -----------------------------------------------------------------------------
# Dispatch Action
# -----------------------------------------------------------------------------
case "$ACTION" in
    status)    action_status ;;
    apikey)    action_apikey ;;
    start)     action_start ;;
    stop)      action_stop ;;
    restart)   action_restart ;;
    logs)      action_logs ;;
    backup)    action_backup ;;
    update)    action_update ;;
    rollback)  perform_rollback ;;
    snapshot)  action_snapshot ;;
    uninstall) action_uninstall ;;
    check)     main_install ;;
    install)   main_install ;;
    *)         err "Unknown action: $ACTION"; usage; exit 1 ;;
esac
